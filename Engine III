void ManageHedge()
{
   if(g_totalCount == 0) return;

   // Both sides open — check combined profit target
   if(g_hasBuy && g_hasSell)
   {
      if(Use_Hedge_TP && g_totalProfit >= HedgeTakeProfit)
      {
         CloseAllPositions();
         Print("Hedge TP reached: ", g_totalProfit);
      }
      return;
   }

   // BUY only → open hedge SELL
   if(g_hasBuy && !g_hasSell)
   {
      bool shouldHedge = false;

      if(HedgeMode == 0)
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         double avgBuyDist = (g_buyAvgPrice - ask) / _Point / 10.0;
         shouldHedge = (avgBuyDist >= HedgeDistancePips);
      }
      else if(HedgeMode == 1)
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         shouldHedge = (ask < g_buyAvgPrice);
      }
      else if(HedgeMode == 2)
      {
         double atr[];
         if(CopyBuffer(g_atrHandle, 0, 0, 2, atr) == 2)
         {
            double atrRatio = atr[0] / atr[1];
            shouldHedge = (atrRatio > 1.5);
         }
      }
      else if(HedgeMode == 3)
      {
         if(iVolume(_Symbol, g_currentTimeframe, 0) <= 1)
         {
            double close2 = iClose(_Symbol, g_currentTimeframe, 2);
            double close1 = iClose(_Symbol, g_currentTimeframe, 1);
            if(close2 < close1)
               shouldHedge = true;
         }
      }

      if(shouldHedge && g_sellCount < MaxHedgeCount)
      {
         double hedgeLot = NormalizeDouble(Lot * HedgeLotMultiplier, 2);
         double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         if(hedgeLot < minLot) hedgeLot = minLot;

         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         string comment = _Symbol + "-HEDGE-SELL-" + IntegerToString(g_sellCount + 1);

         if(trade.Sell(hedgeLot, _Symbol, bid, 0, 0, comment))
            Print("HEDGE SELL: lot=", hedgeLot, " at ", bid, " mode=", HedgeMode, " TF=", EnumToString(g_currentTimeframe));
         else
         {
            g_lastServerFailTime = TimeCurrent();
            Print("HEDGE SELL FAILED: lot=", hedgeLot, " bid=", bid, " err=", trade.ResultRetcode(), " msg=", trade.ResultRetcodeDescription());
         }
      }
   }
   // SELL only → open hedge BUY
   else if(g_hasSell && !g_hasBuy)
   {
      bool shouldHedge = false;

      if(HedgeMode == 0)
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         double avgSellDist = (ask - g_sellAvgPrice) / _Point / 10.0;
         shouldHedge = (avgSellDist >= HedgeDistancePips);
      }
      else if(HedgeMode == 1)
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         shouldHedge = (ask > g_sellAvgPrice);
      }
      else if(HedgeMode == 2)
      {
         double atr[];
         if(CopyBuffer(g_atrHandle, 0, 0, 2, atr) == 2)
         {
            double atrRatio = atr[0] / atr[1];
            shouldHedge = (atrRatio > 1.5);
         }
      }
      else if(HedgeMode == 3)
      {
         if(iVolume(_Symbol, g_currentTimeframe, 0) <= 1)
         {
            double close2 = iClose(_Symbol, g_currentTimeframe, 2);
            double close1 = iClose(_Symbol, g_currentTimeframe, 1);
            if(close2 > close1)
               shouldHedge = true;
         }
      }

      if(shouldHedge && g_buyCount < MaxHedgeCount)
      {
         double hedgeLot = NormalizeDouble(Lot * HedgeLotMultiplier, 2);
         double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         if(hedgeLot < minLot) hedgeLot = minLot;

         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         string comment = _Symbol + "-HEDGE-BUY-" + IntegerToString(g_buyCount + 1);

         if(trade.Buy(hedgeLot, _Symbol, ask, 0, 0, comment))
            Print("HEDGE BUY: lot=", hedgeLot, " at ", ask, " mode=", HedgeMode, " TF=", EnumToString(g_currentTimeframe));
         else
         {
            g_lastServerFailTime = TimeCurrent();
            Print("HEDGE BUY FAILED: lot=", hedgeLot, " ask=", ask, " err=", trade.ResultRetcode(), " msg=", trade.ResultRetcodeDescription());
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Hedge State Machine — tracks DD/ATR state                         |
//+------------------------------------------------------------------+
void UpdateHedgeState()
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double dd = 0.0;
   if(g_totalProfit < 0 && balance > 0)
      dd = (-g_totalProfit / balance) * 100.0;

   double buyLots = 0.0;
   double sellLots = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
      long type = PositionGetInteger(POSITION_TYPE);
      double vol = PositionGetDouble(POSITION_VOLUME);
      if(type == POSITION_TYPE_BUY) buyLots += vol;
      else if(type == POSITION_TYPE_SELL) sellLots += vol;
   }

   if(buyLots <= 0 || sellLots <= 0)
   {
      g_hedgeState = (dd >= HedgeStartDDPct ? HSTATE_WARNING : HSTATE_NORMAL);
      return;
   }

   double ratio = MathMin(buyLots, sellLots) / MathMax(buyLots, sellLots);

   // State is based on real exposure, not number of tickets.
   if(g_totalProfit >= 0 && ratio >= 0.90)
      g_hedgeState = HSTATE_RECOVERY;
   else if(ratio >= 0.90)
      g_hedgeState = HSTATE_FULL_HEDGE;
   else
      g_hedgeState = HSTATE_PARTIAL_HEDGE;
}

string HedgeStateText()
{
   switch(g_hedgeState)
   {
      case HSTATE_NORMAL:        return "NORMAL";
      case HSTATE_WARNING:       return "WARNING";
      case HSTATE_PARTIAL_HEDGE: return "PARTIAL_HEDGE";
      case HSTATE_FULL_HEDGE:    return "FULL_HEDGE";
      case HSTATE_RECOVERY:      return "RECOVERY";
   }
   return "UNKNOWN";
}

//+------------------------------------------------------------------+
//| Account Safety — daily loss, overall loss, margin level            |
//+------------------------------------------------------------------+
bool AccountSafetyOK()
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(balance <= 0) return false;

   // Margin level check (0 = disabled)
   if(MinMarginLevelPct > 0)
   {
      double marginLevel = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
      if(marginLevel > 0 && marginLevel < MinMarginLevelPct)
      {
         static datetime lastMarginLog = 0;
         if(TimeCurrent() - lastMarginLog > 300)
         {
            lastMarginLog = TimeCurrent();
            Print("SAFETY: Margin level ", DoubleToString(marginLevel, 0), "% < ", DoubleToString(MinMarginLevelPct, 0), "%");
         }
         return false;
      }
   }

   // Overall loss check (0 or negative = disabled)
   if(MaxOverallLossPct > 0 && g_initialBasketEquity > 0)
   {
      double dd = (g_initialBasketEquity - equity) / g_initialBasketEquity * 100.0;
      if(dd >= MaxOverallLossPct)
      {
         static datetime lastDdLog = 0;
         if(TimeCurrent() - lastDdLog > 300)
         {
            lastDdLog = TimeCurrent();
            Print("SAFETY: Overall DD ", DoubleToString(dd, 1), "% >= ", DoubleToString(MaxOverallLossPct, 1), "%");
         }
         return false;
      }
   }

   return true;
}

void HardDDCheck()
{
   // v5.60 default is OFF: do not crystallize a losing hedge at the small
   // basket DD threshold. AccountSafety/MaxOverallLoss remains the emergency layer.
   if(!CloseOnHardDD) return;

   double dd = 0;
   if(g_totalProfit < 0 && AccountInfoDouble(ACCOUNT_BALANCE) > 0)
      dd = (-g_totalProfit / AccountInfoDouble(ACCOUNT_BALANCE)) * 100.0;

   if(dd >= MaxBasketDDPct)
   {
      Print("HARD DD: ", DoubleToString(dd, 1), "% >= ", DoubleToString(MaxBasketDDPct, 1), "%. Closing all.");
      CloseAllPositions();
      g_hedgeState = HSTATE_NORMAL;
      g_hedgeCycles = 0;
   }
}

//+------------------------------------------------------------------+
//| Hedge Profit Lock — lock SL on hedge positions when profitable     |
//+------------------------------------------------------------------+
void ManageHedgeProfitLock()
{
   if(!Use_HedgeProfitLock || !g_hasBuy || !g_hasSell) return;

   double hedgeProfit = 0;
   double hedgeRisk = 0;
   double totalHedgeVol = 0;
   int hedgeCount = 0;
   double atr = GetATRValue();
   double fallbackRiskDist = (atr > 0 ? atr * 2.0 : 100.0 * _Point);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
      if(StringFind(PositionGetString(POSITION_COMMENT), "HEDGE") < 0) continue;

      hedgeCount++;
      double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double vol = PositionGetDouble(POSITION_VOLUME);
      long type = PositionGetInteger(POSITION_TYPE);
      double sl = PositionGetDouble(POSITION_SL);
      hedgeProfit += profit;
      totalHedgeVol += vol;

      double risk = 0;
      if(sl > 0)
      {
         if(type == POSITION_TYPE_BUY)
            {
               if(!OrderCalcProfit(ORDER_TYPE_BUY, _Symbol, vol, open, sl, risk))
                  risk = 0.0;
            }
            else
            {
               if(!OrderCalcProfit(ORDER_TYPE_SELL, _Symbol, vol, open, sl, risk))
                  risk = 0.0;
            }
      }
      if(MathAbs(risk) <= 0)
      {
         double riskSL = (type == POSITION_TYPE_BUY ? open - fallbackRiskDist : open + fallbackRiskDist);
         if(type == POSITION_TYPE_BUY)
            {
               if(!OrderCalcProfit(ORDER_TYPE_BUY, _Symbol, vol, open, riskSL, risk))
                  risk = 0.0;
            }
            else
            {
               if(!OrderCalcProfit(ORDER_TYPE_SELL, _Symbol, vol, open, riskSL, risk))
                  risk = 0.0;
            }
      }
      hedgeRisk += MathAbs(risk);
   }

   if(hedgeCount == 0 || hedgeRisk <= 0 || totalHedgeVol <= 0) return;
   double hedgeR = hedgeProfit / hedgeRisk;
   if(hedgeR < HedgeLockStartR) return;

   g_hedgePeakProfit = MathMax(g_hedgePeakProfit, hedgeProfit);
   double lockMoney = g_hedgePeakProfit * HedgeLockPct / 100.0;
   if(HedgeLockMinProfit > 0 && lockMoney < HedgeLockMinProfit) return;
   if(lockMoney <= 0) return;

   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   if(tickSize <= 0 || tickValue <= 0) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
      if(StringFind(PositionGetString(POSITION_COMMENT), "HEDGE") < 0) continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double vol = PositionGetDouble(POSITION_VOLUME);
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);
      long type = PositionGetInteger(POSITION_TYPE);
      if(vol <= 0) continue;

      // Allocate the desired basket hedge lock money proportionally by hedge volume.
      double allocatedMoney = lockMoney * (vol / totalHedgeVol);
      double moneyPerPrice = (tickValue / tickSize) * vol;
      if(moneyPerPrice <= 0) continue;
      double priceDist = allocatedMoney / moneyPerPrice;
      double desiredSL = (type == POSITION_TYPE_BUY ? open + priceDist : open - priceDist);

      double stopLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
      if(type == POSITION_TYPE_BUY)
      {
         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         desiredSL = MathMin(desiredSL, bid - stopLevel - 2*_Point);
         desiredSL = NormalizeDouble(desiredSL, _Digits);
         if(desiredSL <= open) continue;
         if(currentSL > 0 && desiredSL <= currentSL + 5*_Point) continue;
      }
      else
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         desiredSL = MathMax(desiredSL, ask + stopLevel + 2*_Point);
         desiredSL = NormalizeDouble(desiredSL, _Digits);
         if(desiredSL >= open) continue;
         if(currentSL > 0 && desiredSL >= currentSL - 5*_Point) continue;
      }

      if(trade.PositionModify(ticket, desiredSL, currentTP))
         Print("HEDGE LOCK #", ticket, " SL=", DoubleToString(desiredSL,_Digits),
               " hedgeR=", DoubleToString(hedgeR,2), " lock=$", DoubleToString(allocatedMoney,2));
   }
}

//+------------------------------------------------------------------+
//| v5.60: TRUE cycle NET = realized deal P/L since cycle start      |
//| plus current floating P/L for this symbol and magic.              |
//| This prevents a green primary leg from releasing a losing hedge  |
//| when previous hedge closures already created a realized loss.    |
//+------------------------------------------------------------------+
double GetCandleCycleRealizedProfit(const string symbol,const datetime cycleStart)
{
   if(cycleStart<=0) return 0.0;
   if(!HistorySelect(cycleStart,TimeCurrent())) return 0.0;

   double realized=0.0;
   for(int i=HistoryDealsTotal()-1;i>=0;i--)
   {
      ulong deal=HistoryDealGetTicket(i);
      if(deal==0) continue;
      if(HistoryDealGetString(deal,DEAL_SYMBOL)!=symbol) continue;
      if(HistoryDealGetInteger(deal,DEAL_MAGIC)!=g_magic) continue;
      int entry=(int)HistoryDealGetInteger(deal,DEAL_ENTRY);
      if(entry!=DEAL_ENTRY_IN && entry!=DEAL_ENTRY_OUT && entry!=DEAL_ENTRY_OUT_BY) continue;
      realized += HistoryDealGetDouble(deal,DEAL_PROFIT)
               + HistoryDealGetDouble(deal,DEAL_SWAP)
               + HistoryDealGetDouble(deal,DEAL_COMMISSION);
   }
   return realized;
}

double GetCandleCycleTrueNet(const string symbol,const datetime cycleStart,
                             double &floatingNet,double &realizedNet)
{
   floatingNet=0.0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      floatingNet += PositionGetDouble(POSITION_PROFIT)
                  + PositionGetDouble(POSITION_SWAP);
   }
   realizedNet=GetCandleCycleRealizedProfit(symbol,cycleStart);
   return floatingNet+realizedNet;
}

//+------------------------------------------------------------------+
//| v5.60: Candle-mode directional unlock                             |
//| IMPORTANT: this is per symbol and requires TRUE cycle NET > 0.   |
//+------------------------------------------------------------------+
//| IMPORTANT: this is per symbol. It releases ONLY the opposite      |
//| hedge against a confirmed primary candle direction.               |
//+------------------------------------------------------------------+
double CalculateCandleUnlockScore(const string symbol)
{
   MqlRates rates[];
   ArraySetAsSeries(rates,true);
   if(CopyRates(symbol,g_currentTimeframe,0,3,rates)<3) return 0.0;

   bool bull=(rates[1].close>rates[1].open);
   bool bear=(rates[1].close<rates[1].open);
   if(!bull && !bear) return 0.0;
   double score=0.0;

   if(UnlockUseCandle)
   {
      double priorMid=(rates[2].high+rates[2].low)*0.5;
      if((bull && rates[1].close>priorMid)||(bear && rates[1].close<priorMid)) score+=25.0;
   }

   if(UnlockUseEMA)
   {
      int hf=iMA(symbol,g_currentTimeframe,UnlockEMAFast,0,MODE_EMA,PRICE_CLOSE);
      int hs=iMA(symbol,g_currentTimeframe,UnlockEMASlow,0,MODE_EMA,PRICE_CLOSE);
      double bf[],bs[];
      ArraySetAsSeries(bf,true); ArraySetAsSeries(bs,true);
      if(hf!=INVALID_HANDLE && hs!=INVALID_HANDLE &&
         CopyBuffer(hf,0,1,1,bf)==1 && CopyBuffer(hs,0,1,1,bs)==1)
      {
         if((bull && bf[0]>bs[0])||(bear && bf[0]<bs[0])) score+=20.0;
      }
      if(hf!=INVALID_HANDLE) IndicatorRelease(hf);
      if(hs!=INVALID_HANDLE) IndicatorRelease(hs);
   }

   if(UnlockUseADX)
   {
      int h=iADX(symbol,g_currentTimeframe,UnlockADXPeriod);
      double b[]; ArraySetAsSeries(b,true);
      if(h!=INVALID_HANDLE && CopyBuffer(h,0,1,1,b)==1)
      {
         if(b[0]>=UnlockADXNeutral) score+=15.0;
         if(b[0]>=UnlockADXTrend) score+=10.0;
      }
      if(h!=INVALID_HANDLE) IndicatorRelease(h);
   }

   if(UnlockUseATR)
   {
      double atr=GetPairATR(symbol,g_currentTimeframe,14);
      double body=MathAbs(rates[1].close-rates[1].open);
      if(atr>0.0 && body>=atr*UnlockATRBodyFactor) score+=20.0;
   }
   return MathMax(0.0,MathMin(100.0,score));
}

// Returns symbol-local NET profit and primary/hedge profit for the candle cycle.
void GetCandleDirectionalState(const string symbol,
                               double &netProfit,
                               double &primaryProfit,
                               double &hedgeProfit,
                               long &primaryDirection,
                               double &hedgeVolume,
                               datetime &oldestTime)
{
   netProfit=0.0; primaryProfit=0.0; hedgeProfit=0.0;
   double buyPrimaryProfit=0.0, sellPrimaryProfit=0.0;
   primaryDirection=-1; hedgeVolume=0.0; oldestTime=0;

   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;

      double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      netProfit+=p;
      string c=PositionGetString(POSITION_COMMENT);
      long type=PositionGetInteger(POSITION_TYPE);
      datetime ot=(datetime)PositionGetInteger(POSITION_TIME);
      if(oldestTime==0 || ot<oldestTime) oldestTime=ot;

      if(StringFind(c,"-CANDLE-HEDGE-")>=0)
      {
         hedgeProfit+=p;
         hedgeVolume+=PositionGetDouble(POSITION_VOLUME);
      }
      else if(StringFind(c,"-CANDLE-BUY-")>=0 || StringFind(c,"-CANDLE-SELL-")>=0)
      {
         primaryProfit+=p;
         if(type==POSITION_TYPE_BUY) buyPrimaryProfit+=p;
         else if(type==POSITION_TYPE_SELL) sellPrimaryProfit+=p;
      }
   }
   if(buyPrimaryProfit>sellPrimaryProfit && buyPrimaryProfit>0.0)
      primaryDirection=POSITION_TYPE_BUY;
   else if(sellPrimaryProfit>buyPrimaryProfit && sellPrimaryProfit>0.0)
      primaryDirection=POSITION_TYPE_SELL;
   else if(buyPrimaryProfit>0.0)
      primaryDirection=POSITION_TYPE_BUY;
   else if(sellPrimaryProfit>0.0)
      primaryDirection=POSITION_TYPE_SELL;
}

bool CandleUnlockCooldownOK(const string symbol,const datetime lastUnlock)
{
   if(lastUnlock<=0) return true;
   int shift=iBarShift(symbol,g_currentTimeframe,lastUnlock,false);
   if(shift<0) return true;
   return shift>=CandleUnlockCooldownBars;
}

bool CloseCandleHedgeVolume(const string symbol,CTrade &trader,
                            const long primaryDirection,const double targetVolume)
{
   if(targetVolume<=0.0) return false;
   double remaining=targetVolume;
   double minLot=SymbolInfoDouble(symbol,SYMBOL_VOLUME_MIN);
   double step=SymbolInfoDouble(symbol,SYMBOL_VOLUME_STEP);
   if(minLot<=0.0 || step<=0.0) return false;

   // Primary BUY => remove SELL hedge. Primary SELL => remove BUY hedge.
   long hedgeDirection=(primaryDirection==POSITION_TYPE_BUY ? POSITION_TYPE_SELL : POSITION_TYPE_BUY);
   bool changed=false;
   for(int i=PositionsTotal()-1;i>=0 && remaining>=minLot;i--)
   {
      ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      if(PositionGetInteger(POSITION_TYPE)!=hedgeDirection) continue;
      string c=PositionGetString(POSITION_COMMENT);
      if(StringFind(c,"-CANDLE-HEDGE-")<0) continue;

      double vol=PositionGetDouble(POSITION_VOLUME);
      double closeVol=MathMin(vol,remaining);
      closeVol=MathFloor(closeVol/step)*step;
      closeVol=NormalizeDouble(closeVol,8);
      if(closeVol<minLot) continue;

      bool ok=false;
      if(closeVol>=vol-step/2.0) ok=trader.PositionClose(ticket);
      else ok=trader.PositionClosePartial(ticket,closeVol);
      if(ok)
      {
         changed=true;
         remaining-=closeVol;
         Print("V5.60 UNLOCK ",symbol," hedge #",ticket,
               " released=",DoubleToString(closeVol,8),
               " remainingTarget=",DoubleToString(MathMax(remaining,0.0),8));
      }
   }
   return changed;
}

bool ManageCandleDynamicUnlockSymbol(const string symbol,CTrade &trader,
                                     datetime &unlockStart,
                                     datetime &lastUnlock,
                                     int &unlockStage)
{
   if(!CandleDynamicUnlockEnabled) return false;

   double net=0.0,primary=0.0,hedge=0.0,hedgeVol=0.0;
   long direction=-1;
   datetime oldest=0;
   GetCandleDirectionalState(symbol,net,primary,hedge,direction,hedgeVol,oldest);
   if(direction<0 || hedgeVol<=0.0) { unlockStart=0; unlockStage=0; return false; }

   // Keep the original cycle start while positions remain. Do NOT move it
   // forward when an older hedge leg is closed; otherwise realized hedge
   // losses would disappear from the TRUE NET calculation.
   if(unlockStart==0) unlockStart=oldest;

   int ageBars=0;
   if(unlockStart>0)
   {
      ageBars=iBarShift(symbol,g_currentTimeframe,unlockStart,false);
      if(ageBars<0) ageBars=0;
   }

   if(!CandleUnlockCooldownOK(symbol,lastUnlock)) return false;
   if(CandleUnlockRequirePrimaryProfit && primary<CandleUnlockMinPrimaryProfit) return false;

   double floatingNet=0.0, realizedNet=0.0;
   double trueNet=GetCandleCycleTrueNet(symbol,unlockStart,floatingNet,realizedNet);

   double score=CalculateCandleUnlockScore(symbol);
   if(score<UnlockScoreStage1) return false;

   // v5.60: time-based rescue may accelerate the next stage, but it can
   // NEVER release a losing hedge. TRUE NET must remain positive.
   bool rescue=(ageBars>=CandleUnlockMaxHoldBars && score>=CandleUnlockRescueScore && primary>0.0 && trueNet>=CandleUnlockMinNetProfit);
   if(trueNet<CandleUnlockMinNetProfit) return false;

   int desiredPct=0;
   if(score>=UnlockScoreFull) desiredPct=100;
   else if(score>=UnlockScoreStage3) desiredPct=75;
   else if(score>=UnlockScoreStage2) desiredPct=50;
   else if(score>=UnlockScoreStage1) desiredPct=25;
   if(desiredPct<=0) return false;

   // Never jump from 0 to a large release unless the score actually qualifies.
   int previousPct=unlockStage*25;
   if(desiredPct<=previousPct) return false;

   int stagePct=desiredPct-previousPct;
   double closeVol=hedgeVol*stagePct/100.0;
   if(rescue && previousPct==0)
      closeVol=hedgeVol*25.0/100.0;
   if(closeVol<=0.0) return false;

   if(CloseCandleHedgeVolume(symbol,trader,direction,closeVol))
   {
      unlockStage=MathMin(4,previousPct/25 + stagePct/25);
      if(unlockStage<=0) unlockStage=1;
      lastUnlock=TimeCurrent();
      Print("V5.60 DYNAMIC UNLOCK ",symbol,
            " score=",DoubleToString(score,1),
            " stage=",IntegerToString(unlockStage),
            " released=",IntegerToString(stagePct),"%",
            " primary=$",DoubleToString(primary,2),
            " floating=$",DoubleToString(floatingNet,2),
            " realized=$",DoubleToString(realizedNet,2),
            " TRUE_NET=$",DoubleToString(trueNet,2),
            " ageBars=",IntegerToString(ageBars),
            (rescue?" RESCUE":""));
      return true;
   }
   return false;
}

