//+------------------------------------------------------------------+
//| Execute the selected Equity ATR Trail close mode                 |
//| 0 = whole basket, 1 = profitable positions only, 2 = selected side|
//+------------------------------------------------------------------+
int CloseByEquityTrailMode()
{
   int closedOrRequested = 0;
   CaptureMultiPairPeakVolumes();

   if(g_peakVolume <= 0)
      g_peakVolume = MathMax(g_lot, Lot);

   // Preserve peak volume for the next candle cycle.  The multiplier
   // is applied ONCE to the saved peak volume; default 1.00 = no doubling.
   if(g_peakVolume > 0)
   {
      g_reusePeakVolume = true;
      g_nextCandleVolume = NormalizeCandleVolume(
         g_peakVolume * MathMax(CandleCycleMultiplier, 0.0));
   }

   if(EquityATR_CloseMode == EQUITY_TRAIL_CLOSE_BASKET)
   {
      CloseAllPositions();
      closedOrRequested = 1;
      Print("EQUITY ATR TRAIL: CLOSE MODE = BASKET");
   }
   else if(EquityATR_CloseMode == EQUITY_TRAIL_CLOSE_PROFITABLE)
   {
      ClosePositionsByProfit(true);
      closedOrRequested = 1;
      Print("EQUITY ATR TRAIL: CLOSE MODE = PROFITABLE ONLY");
   }
   else if(EquityATR_CloseMode == EQUITY_TRAIL_CLOSE_SELECTED_SIDE)
   {
      ClosePositionsByType(EquityATR_SelectedSide);
      closedOrRequested = 1;
      Print("EQUITY ATR TRAIL: CLOSE MODE = SELECTED SIDE (",
            EnumToString(EquityATR_SelectedSide), ")");
   }

   return closedOrRequested;
}

//+------------------------------------------------------------------+
void ManageEquityATRTrail()
{
   double atrVal[];
   ArraySetAsSeries(atrVal, true);
   if(CopyBuffer(g_equityAtrHandle, 0, 0, 1, atrVal) < 1) return;
   if(atrVal[0] <= 0) return;

   double equity = AccountInfoDouble(ACCOUNT_EQUITY);

   // A new equity peak can optionally close/reduce positions according
   // to the SAME selectable close mode.  This used to always close all.
   if(g_equityTrailActive && EquityATR_CloseOnNewPeak && equity > g_peakEquity)
   {
      Print("EQUITY ATR TRAIL: New peak ", DoubleToString(equity, 2),
            " > old peak ", DoubleToString(g_peakEquity, 2),
            " - executing close mode ", IntegerToString((int)EquityATR_CloseMode));

      CloseByEquityTrailMode();
      g_peakEquity = equity;
      g_equityTrailActive = false;
      return;
   }

   // Update peak equity.
   if(equity > g_peakEquity)
      g_peakEquity = equity;

   // Calculate equity drop from peak in ATR units.
   double dropFromPeak = (g_peakEquity - equity) / atrVal[0];

   // Convert enum to actual multiplier (enum values are 10x).
   double startMult = EquityATR_StartMult / 10.0;
   double closeMult = EquityATR_CloseMult / 10.0;

   // Activate trail when drop exceeds start multiplier.
   if(dropFromPeak >= startMult)
      g_equityTrailActive = true;

   // Close/reduce when drop exceeds close multiplier.
   if(g_equityTrailActive && dropFromPeak >= closeMult)
   {
      CloseByEquityTrailMode();

      Print("EQUITY ATR TRAIL: mode=", IntegerToString((int)EquityATR_CloseMode),
            " drop=", DoubleToString(dropFromPeak, 1),
            " ATR from peak=", DoubleToString(g_peakEquity, 2),
            " threshold=", DoubleToString(closeMult, 1), " ATR",
            " nextCycleVolume=", DoubleToString(g_nextCandleVolume, 2));

      // Reset trail state.  Peak volume is intentionally NOT reset.
      g_peakEquity = AccountInfoDouble(ACCOUNT_EQUITY);
      g_equityTrailActive = false;
   }
}

