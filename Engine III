bool IsStrongCounterTrend(int direction)
{
   if(!BlockCounterTrendAvg) return false;
   double price = (direction == 1 ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID));
   if(price <= 0) return false;

   double adx = 0;
   if(g_smartTrailAdxHandle != INVALID_HANDLE)
   {
      double a[];
      ArraySetAsSeries(a, true);
      if(CopyBuffer(g_smartTrailAdxHandle, 0, 0, 1, a) == 1)
         adx = a[0];
   }
   if(adx < CounterTrendADX) return false;

   int maHandle = iMA(_Symbol, PERIOD_CURRENT, CounterTrendMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   if(maHandle == INVALID_HANDLE) return false;
   double ema[];
   ArraySetAsSeries(ema, true);
   bool ok = (CopyBuffer(maHandle, 0, 0, 1, ema) == 1);
   IndicatorRelease(maHandle);
   if(!ok || ema[0] <= 0) return false;

   // BUY averaging while price is strongly below EMA = counter-trend.
   // SELL averaging while price is strongly above EMA = counter-trend.
   if(direction == 1 && price < ema[0]) return true;
   if(direction == 2 && price > ema[0]) return true;
   return false;
}

bool EntryProtectionOK(int direction, double entryPrice)
{
   if(!Use_EntryProtection) return true;
   if(entryPrice <= 0) return false;

   if(g_buyCount + g_sellCount > 0)
   {
      datetime barTime = iTime(_Symbol, g_currentTimeframe, 0);
      if(EntryCooldownBars > 0 && g_lastEntryBarTime > 0)
      {
         int barsSince = iBarShift(_Symbol, g_currentTimeframe, g_lastEntryBarTime, false);
         if(barsSince >= 0 && barsSince < EntryCooldownBars)
            return false;
      }
      if(EntryCooldownSec > 0 && g_lastTradeTime > 0 && TimeCurrent() - g_lastTradeTime < EntryCooldownSec)
         return false;
   }

   int sameCount = (direction == 1 ? g_buyCount : g_sellCount);
   if(sameCount >= MaxSameDirectionTrades) return false;

   double atr = GetATRValue();
   double minDist = EntryMinDistancePts * _Point;
   if(atr > 0 && EntryMinDistanceATR > 0)
      minDist = MathMax(minDist, atr * EntryMinDistanceATR);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
      long type = PositionGetInteger(POSITION_TYPE);
      if((direction == 1 && type != POSITION_TYPE_BUY) || (direction == 2 && type != POSITION_TYPE_SELL)) continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      if(MathAbs(entryPrice - open) < minDist)
      {
         Print("ENTRY BLOCKED: too close to existing ", (direction == 1 ? "BUY" : "SELL"),
               " #", ticket, " distance=", DoubleToString(MathAbs(entryPrice-open)/_Point, 1),
               " required=", DoubleToString(minDist/_Point, 1));
         return false;
      }
   }

   return true;
}

//+------------------------------------------------------------------+
//| Basket DD Lock Trail — protect a percentage of peak basket profit |
//+------------------------------------------------------------------+
bool ManageBasketDDLock()
{
   if(!Use_BasketDDLock || g_totalCount <= 0) return false;
   if(g_lastBasketLockAction > 0 && TimeCurrent() - g_lastBasketLockAction < BasketLockCooldownSec)
      return false;

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   if(balance <= 0) return false;

   double startMoney = balance * BasketLockStartPct / 100.0;
   double minLockMoney = balance * BasketLockMinProfit / 100.0;

   if(g_totalProfit > g_bestBasketProfit)
      g_bestBasketProfit = g_totalProfit;

   if(g_bestBasketProfit < startMoney)
      return false;

   double lockMoney = MathMax(minLockMoney, g_bestBasketProfit * BasketLockPct / 100.0);
   if(lockMoney <= 0) return false;

   // Only close on a genuine retracement from the peak, never while the basket is still making new highs.
   if(g_totalProfit <= lockMoney && g_bestBasketProfit > lockMoney)
   {
      Print("BASKET DD LOCK: peak=", DoubleToString(g_bestBasketProfit, 2),
            " current=", DoubleToString(g_totalProfit, 2),
            " protected=", DoubleToString(lockMoney, 2),
            " (", DoubleToString(BasketLockPct, 1), "%)");
      // Preserve the largest volume used by the closed cycle. The next candle cycle
      // reuses PeakVolume instead of resetting or doubling it.
      if(g_peakVolume <= 0)
         g_peakVolume = MathMax(g_lot, Lot);
      g_reusePeakVolume = (g_peakVolume > 0);
      g_nextCandleVolume = NormalizeCandleVolume(g_peakVolume * MathMax(CandleCycleMultiplier, 0.0));

      CloseAllPositions();
      g_lastBasketLockAction = TimeCurrent();
      g_bestBasketProfit = -DBL_MAX;
      g_hedgePeakProfit = 0.0;
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| Closed-candle paired entry engine                                |
//| Bullish closed candle  -> BUY + immediate SELL hedge             |
//| Bearish closed candle  -> SELL + immediate BUY hedge             |
//| One signal per newly opened candle. Volume never doubles unless  |
//| CandleCycleMultiplier is explicitly increased.                   |
//+------------------------------------------------------------------+
double NormalizeCandleVolume(double volume)
{
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(stepLot <= 0) stepLot = minLot;
   if(stepLot <= 0) stepLot = 0.01;

   volume = MathMax(minLot, MathMin(maxLot, volume));
   volume = MathFloor(volume / stepLot + 1e-9) * stepLot;
   volume = MathMax(minLot, MathMin(maxLot, volume));
   return NormalizeDouble(volume, 8);
}

bool CandlePriceAllowed(int direction, double price, double minAtrDistance)
{
   if(!CandleUsePriceFilter) return true;
   if(price <= 0) return false;

   double atr = GetATRValue();
   double minDist = 0.0;
   if(atr > 0 && CandleMinDistanceATR > 0)
      minDist = atr * CandleMinDistanceATR;

   if(minAtrDistance > minDist)
      minDist = minAtrDistance;

   // Always block an effectively identical price, even if ATR is unavailable.
   double samePriceTol = MathMax(2.0 * _Point, minDist * 0.10);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;

      long type = PositionGetInteger(POSITION_TYPE);
      if((direction == 1 && type != POSITION_TYPE_BUY) ||
         (direction == 2 && type != POSITION_TYPE_SELL))
         continue;

      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double distance = MathAbs(price - open);

      if(distance <= samePriceTol)
      {
         Print("CANDLE ENTRY BLOCKED: same/near price. direction=", direction,
               " existing=", DoubleToString(open,_Digits),
               " new=", DoubleToString(price,_Digits));
         return false;
      }

      if(minDist > 0 && distance < minDist)
      {
         Print("CANDLE ENTRY BLOCKED: too close. direction=", direction,
               " distance=", DoubleToString(distance/_Point,1),
               " required=", DoubleToString(minDist/_Point,1));
         return false;
      }
   }
   return true;
}

double GetCandleCycleVolume()
{
   double volume = GetFirstLot();

   if(CandleUsePeakVolume && g_reusePeakVolume && g_peakVolume > 0)
      volume = g_peakVolume * MathMax(CandleCycleMultiplier, 0.0);
   else if(g_peakVolume > 0 && CandleUsePeakVolume)
      volume = g_peakVolume;

   return NormalizeCandleVolume(volume);
}

bool OpenCandlePair(int direction, double primaryLot)
{
   double hedgeLot = NormalizeCandleVolume(primaryLot * MathMax(CandleHedgeMultiplier, 0.0));
   primaryLot = NormalizeCandleVolume(primaryLot);
   if(primaryLot <= 0 || hedgeLot <= 0) return false;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(ask <= 0 || bid <= 0) return false;

   // Check both sides BEFORE opening either leg, so a pair cannot become half-open
   // simply because one side is too close to an existing price.
   if(direction == 1)
   {
      if(!CandlePriceAllowed(1, ask, 0.0)) return false;
      if(!CandlePriceAllowed(2, bid, 0.0)) return false;
   }
   else
   {
      if(!CandlePriceAllowed(2, bid, 0.0)) return false;
      if(!CandlePriceAllowed(1, ask, 0.0)) return false;
   }

   string stamp = IntegerToString((int)iTime(_Symbol, g_currentTimeframe, 1));
   bool primaryOK = false;
   bool hedgeOK = false;

   if(direction == 1)
   {
      primaryOK = trade.Buy(primaryLot, _Symbol, ask, 0, 0,
                            _Symbol + "-CANDLE-BUY-" + stamp);
      if(!primaryOK)
      {
         g_lastServerFailTime = TimeCurrent();
         Print("CANDLE BUY FAILED: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
         return false;
      }

      // Immediate hedge: opposite side, same candle, no delay.
      hedgeOK = trade.Sell(hedgeLot, _Symbol, bid, 0, 0,
                           _Symbol + "-CANDLE-HEDGE-SELL-" + stamp);
   }
   else
   {
      primaryOK = trade.Sell(primaryLot, _Symbol, bid, 0, 0,
                             _Symbol + "-CANDLE-SELL-" + stamp);
      if(!primaryOK)
      {
         g_lastServerFailTime = TimeCurrent();
         Print("CANDLE SELL FAILED: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
         return false;
      }

      // Immediate hedge: opposite side, same candle, no delay.
      hedgeOK = trade.Buy(hedgeLot, _Symbol, ask, 0, 0,
                          _Symbol + "-CANDLE-HEDGE-BUY-" + stamp);
   }

   if(!hedgeOK)
   {
      g_lastServerFailTime = TimeCurrent();
      Print("CANDLE HEDGE FAILED: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription(),
            ". Closing primary leg to avoid an unintended naked position.");

      // Best effort rollback of the primary leg.
      for(int i = PositionsTotal()-1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;
         string c = PositionGetString(POSITION_COMMENT);
         if(StringFind(c, stamp) >= 0)
            trade.PositionClose(ticket);
      }
      return false;
   }

   if(primaryLot > g_peakVolume)
      g_peakVolume = primaryLot;
   if(hedgeLot > g_peakVolume)
      g_peakVolume = hedgeLot;

   g_reusePeakVolume = false;
   g_nextCandleVolume = g_peakVolume;
   g_lastTradeTime = TimeCurrent();
   g_lastEntryBarTime = iTime(_Symbol, g_currentTimeframe, 0);
   g_lastCandleSignalBar = iTime(_Symbol, g_currentTimeframe, 0);
   g_candleUnlockStart = TimeCurrent();
   g_candleUnlockStage = 0;
   g_lastUnlockBar = 0;

   Print("CANDLE PAIR OPENED: ", (direction == 1 ? "BUY + SELL HEDGE" : "SELL + BUY HEDGE"),
         " primary=", DoubleToString(primaryLot,8),
         " hedge=", DoubleToString(hedgeLot,8),
         " peakVolume=", DoubleToString(g_peakVolume,8),
         " closedCandle=", TimeToString(iTime(_Symbol,g_currentTimeframe,1)));
   return true;
}

void ManageClosedCandlePairEntries()
{
   if(!Use_CandleClosedEntryMode) return;
   if(g_manualPaused || (!g_canTrade && g_totalCount == 0)) return;
   if(!CheckTimeFilter() || g_newsActive) return;
   if(!CheckVolatilityFilter()) return;
   if(g_totalCount >= MaxTrades) return;

   datetime currentBar = iTime(_Symbol, g_currentTimeframe, 0);
   if(currentBar <= 0 || currentBar == g_lastCandleSignalBar) return;

   // Use the COMPLETED candle only.
   double candleOpen  = iOpen(_Symbol, g_currentTimeframe, 1);
   double candleClose = iClose(_Symbol, g_currentTimeframe, 1);
   if(candleOpen <= 0 || candleClose <= 0) return;
   if(candleClose == candleOpen)
   {
      g_lastCandleSignalBar = currentBar;
      return;
   }

   int direction = (candleClose > candleOpen ? 1 : 2);

   int pairCount = MathMin(g_buyCount, g_sellCount);
   if(pairCount >= CandleMaxPairs)
      return;

   // One pair per newly opened candle. Low TF = more opportunities; high TF = fewer.
   double volume = GetCandleCycleVolume();
   if(volume <= 0) return;

   // Respect the global minimum delay only between different candle signals.
   if(g_totalCount > 0 && MinTradeDelaySec > 0 &&
      TimeCurrent() - g_lastTradeTime < MinTradeDelaySec)
      return;

   if(OpenCandlePair(direction, volume))
   {
      g_averagingCount = 0;
      g_buyAveragingCount = 0;
      g_sellAveragingCount = 0;
      g_timeoutTime = TimeCurrent() + (TimeOut_Hours * 3600);
   }
}

