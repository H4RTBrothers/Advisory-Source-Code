void GetCandleUnlockMeta(const string symbol,
                         datetime &unlockStart,
                         datetime &lastUnlock,
                         int &unlockStage)
{
   unlockStart=0; lastUnlock=0; unlockStage=0;
   if(symbol==_Symbol && !Use_MultiPair)
   {
      unlockStart=g_candleUnlockStart;
      lastUnlock=g_lastUnlockBar;
      unlockStage=g_candleUnlockStage;
      return;
   }
   for(int p=0;p<g_pairCount;p++)
   {
      if(g_pts[p].symbol==symbol)
      {
         unlockStart=g_pts[p].candleUnlockStart;
         lastUnlock=g_pts[p].candleLastUnlockTime;
         unlockStage=g_pts[p].candleUnlockStage;
         return;
      }
   }
}

string GetCandleUnlockWaitReason(const string symbol,
                                 string &stateText,
                                 string &directionText,
                                 double &primary,
                                 double &hedge,
                                 double &floatingNet,
                                 double &realizedNet,
                                 double &trueNet,
                                 double &score,
                                 int &ageBars,
                                 int &currentPct,
                                 int &nextPct,
                                 int &cooldownBars)
{
   stateText="NO_POSITIONS";
   directionText="NONE";
   primary=0.0; hedge=0.0; floatingNet=0.0; realizedNet=0.0; trueNet=0.0;
   score=0.0; ageBars=0; currentPct=0; nextPct=0; cooldownBars=0;

   datetime unlockStart=0,lastUnlock=0;
   int unlockStage=0;
   GetCandleUnlockMeta(symbol,unlockStart,lastUnlock,unlockStage);
   currentPct=MathMax(0,MathMin(100,unlockStage*25));

   int buyCount=0,sellCount=0;
   double buyVol=0.0,sellVol=0.0;
   long buyPrimary=0,sellPrimary=0;
   datetime oldest=0;

   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      long type=PositionGetInteger(POSITION_TYPE);
      double vol=PositionGetDouble(POSITION_VOLUME);
      string c=PositionGetString(POSITION_COMMENT);
      datetime ot=(datetime)PositionGetInteger(POSITION_TIME);
      if(oldest==0 || ot<oldest) oldest=ot;
      if(type==POSITION_TYPE_BUY){buyCount++; buyVol+=vol;}
      else {sellCount++; sellVol+=vol;}
      double pp=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      if(StringFind(c,"-CANDLE-HEDGE-")>=0) hedge+=pp;
      else if(StringFind(c,"-CANDLE-BUY-")>=0){primary+=pp; buyPrimary++;}
      else if(StringFind(c,"-CANDLE-SELL-")>=0){primary+=pp; sellPrimary++;}
   }

   if(buyCount==0 && sellCount==0)
      return "NO OPEN POSITIONS";

   // State is based on the candle unlock stage, not the legacy global hedge state.
   if(buyCount>0 && sellCount>0)
      stateText=(unlockStage<=0 ? "FULL_HEDGE" : (unlockStage<4 ? "PARTIAL_HEDGE" : "DIRECTIONAL"));
   else
      stateText="DIRECTIONAL";

   long direction=-1;
   double bp=0.0,sp=0.0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      string c=PositionGetString(POSITION_COMMENT);
      if(StringFind(c,"-CANDLE-HEDGE-")>=0) continue;
      double pp=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      long type=PositionGetInteger(POSITION_TYPE);
      if(type==POSITION_TYPE_BUY) bp+=pp; else if(type==POSITION_TYPE_SELL) sp+=pp;
   }
   if(bp>sp && bp>0.0) direction=POSITION_TYPE_BUY;
   else if(sp>bp && sp>0.0) direction=POSITION_TYPE_SELL;
   if(direction==POSITION_TYPE_BUY) directionText="BUY";
   else if(direction==POSITION_TYPE_SELL) directionText="SELL";
   else directionText="NONE";

   if(oldest>0)
   {
      ageBars=iBarShift(symbol,g_currentTimeframe,oldest,false);
      if(ageBars<0) ageBars=0;
   }
   if(unlockStart==0) unlockStart=oldest;
   if(unlockStart>0)
   {
      int a=iBarShift(symbol,g_currentTimeframe,unlockStart,false);
      if(a>=0) ageBars=MathMax(ageBars,a);
      trueNet=GetCandleCycleTrueNet(symbol,unlockStart,floatingNet,realizedNet);
   }
   else
   {
      trueNet=GetCandleCycleTrueNet(symbol,0,floatingNet,realizedNet);
   }

   if(lastUnlock>0)
   {
      int sh=iBarShift(symbol,g_currentTimeframe,lastUnlock,false);
      if(sh>=0) cooldownBars=MathMax(0,CandleUnlockCooldownBars-sh);
   }

   if(direction>=0 && (buyCount>0 && sellCount>0 || StringFind(stateText,"HEDGE")>=0))
      score=CalculateCandleUnlockScore(symbol);

   if(!CandleDynamicUnlockEnabled)
      return "DYNAMIC UNLOCK DISABLED";
   if(direction<0)
      return "NO PROFITABLE PRIMARY DIRECTION";
   double hedgeVol=(direction==POSITION_TYPE_BUY?sellVol:buyVol);
   if(hedgeVol<=0.0)
      return "NO OPPOSITE HEDGE";
   if(!CandleUnlockCooldownOK(symbol,lastUnlock))
      return "COOLDOWN: WAIT " + IntegerToString(MathMax(cooldownBars,1)) + " BAR";
   if(CandleUnlockRequirePrimaryProfit && primary<CandleUnlockMinPrimaryProfit)
      return "PRIMARY P/L LOW: $"+DoubleToString(primary,2)+" < $"+DoubleToString(CandleUnlockMinPrimaryProfit,2);
   if(score<UnlockScoreStage1)
      return "SCORE LOW: "+DoubleToString(score,0)+" < "+DoubleToString(UnlockScoreStage1,0);
   if(trueNet<CandleUnlockMinNetProfit)
      return "TRUE NET LOW: $"+DoubleToString(trueNet,2)+" < $"+DoubleToString(CandleUnlockMinNetProfit,2);

   if(score>=UnlockScoreFull) nextPct=100;
   else if(score>=UnlockScoreStage3) nextPct=75;
   else if(score>=UnlockScoreStage2) nextPct=50;
   else if(score>=UnlockScoreStage1) nextPct=25;
   if(nextPct<=currentPct)
      return "WAIT NEXT CANDLE / NEW SCORE";

   return "READY: RELEASE "+IntegerToString(nextPct-currentPct)+"%";
}

