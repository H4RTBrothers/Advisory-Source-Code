datetime DashboardDayStart()
{
   MqlDateTime dt;
   TimeCurrent(dt);
   dt.hour=0; dt.min=0; dt.sec=0;
   return StructToTime(dt);
}

double DashboardTodayRealized()
{
   datetime dayStart=DashboardDayStart();
   datetime now=TimeCurrent();
   if(!HistorySelect(dayStart,now)) return 0.0;
   double result=0.0;
   int total=HistoryDealsTotal();
   for(int i=0;i<total;i++)
   {
      ulong ticket=HistoryDealGetTicket(i);
      if(ticket==0) continue;
      if(!DashboardMagicAllowed(HistoryDealGetInteger(ticket,DEAL_MAGIC))) continue;
      result += HistoryDealGetDouble(ticket,DEAL_PROFIT)
             + HistoryDealGetDouble(ticket,DEAL_SWAP)
             + HistoryDealGetDouble(ticket,DEAL_COMMISSION);
   }
   return result;
}

double DashboardFloatingAll()
{
   double result=0.0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      result += PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
   }
   return result;
}

double DashboardCurrentDDPct()
{
   double eq=AccountInfoDouble(ACCOUNT_EQUITY);
   if(g_dashboardPeakEquity<=0.0) return 0.0;
   double dd=(g_dashboardPeakEquity-eq)/g_dashboardPeakEquity*100.0;
   return MathMax(0.0,dd);
}

string DashboardFormatMoney(double v)
{
   return (v>=0.0?"+":"")+DoubleToString(v,2);
}

string DashboardFormatLot(double v)
{
   return DoubleToString(MathMax(0.0,v),2);
}

string DashboardCandleState()
{
   MqlRates r[];
   ArraySetAsSeries(r,true);
   if(CopyRates(_Symbol,g_currentTimeframe,1,1,r)!=1) return "N/A";
   double range=r[0].high-r[0].low;
   if(range<=0.0) return "DOJI";
   double body=MathAbs(r[0].close-r[0].open);
   double ratio=body/range*100.0;
   if(r[0].close>r[0].open) return "BULL "+DoubleToString(ratio,0)+"%";
   if(r[0].close<r[0].open) return "BEAR "+DoubleToString(ratio,0)+"%";
   return "DOJI "+DoubleToString(ratio,0)+"%";
}

color DashboardCandleColor()
{
   MqlRates r[];
   ArraySetAsSeries(r,true);
   if(CopyRates(_Symbol,g_currentTimeframe,1,1,r)!=1) return CLR_DIM;
   if(r[0].close>r[0].open) return DashboardBullCandleColor;
   if(r[0].close<r[0].open) return DashboardBearCandleColor;
   return CLR_DIM;
}

