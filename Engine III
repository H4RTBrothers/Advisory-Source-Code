//+------------------------------------------------------------------+
//| v5.55: Normalize volume for an individual multi-pair symbol      |
//+------------------------------------------------------------------+
double NormalizePairVolume(const string symbol, double volume)
{
   double minLot  = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double step    = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   if(minLot <= 0 || maxLot <= 0 || step <= 0 || volume <= 0) return 0.0;
   volume = MathMax(minLot, MathMin(maxLot, volume));
   volume = MathFloor((volume + 1e-12) / step) * step;
   if(volume < minLot) volume = minLot;
   int digits = 0;
   double x = step;
   while(digits < 8 && MathAbs(x - MathRound(x)) > 1e-10) { x *= 10.0; digits++; }
   return NormalizeDouble(volume, digits);
}

//+------------------------------------------------------------------+
//| v5.55: ATR for an arbitrary symbol                               |
//+------------------------------------------------------------------+
double GetPairATR(const string symbol, ENUM_TIMEFRAMES tf, int period)
{
   int h = iATR(symbol, tf, period);
   if(h == INVALID_HANDLE) return 0.0;
   double a[];
   ArraySetAsSeries(a, true);
   double result = 0.0;
   if(CopyBuffer(h, 0, 0, 1, a) == 1) result = a[0];
   IndicatorRelease(h);
   return result;
}

//+------------------------------------------------------------------+
//| v5.55: Save each multi-pair's peak volume before a global exit   |
//+------------------------------------------------------------------+
void CaptureMultiPairPeakVolumes()
{
   if(!Use_MultiPair) return;
   for(int p=0; p<g_pairCount; p++)
   {
      string symbol = g_pts[p].symbol;
      double peak = g_pts[p].candlePeakVolume;
      for(int i=PositionsTotal()-1; i>=0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
         double v=PositionGetDouble(POSITION_VOLUME);
         if(v>peak) peak=v;
      }
      if(peak>0)
      {
         g_pts[p].candlePeakVolume=peak;
         g_pts[p].candleNextVolume=NormalizePairVolume(symbol, peak*MathMax(CandleCycleMultiplier,0.0));
         g_pts[p].candleReusePeak=true;
      }
   }
}

//+------------------------------------------------------------------+
//| v5.55: Price protection for a multi-pair candle entry            |
//+------------------------------------------------------------------+
bool PairCandlePriceAllowed(int idx, int direction, double entryPrice)
{
   if(idx<0 || idx>=g_pairCount) return false;
   if(!CandleUsePriceFilter) return true;
   string symbol=g_pts[idx].symbol;
   double point=SymbolInfoDouble(symbol,SYMBOL_POINT);
   if(point<=0) return false;
   double atr=GetPairATR(symbol,g_currentTimeframe,ATR_Period);
   double minDist=0.0;
   if(CandleMinDistanceATR>0 && atr>0) minDist=atr*CandleMinDistanceATR;
   if(EntryMinDistancePts>0) minDist=MathMax(minDist,EntryMinDistancePts*point);
   if(minDist<=0) return true;
   int same=0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      long type=PositionGetInteger(POSITION_TYPE);
      if((direction==1 && type!=POSITION_TYPE_BUY)||(direction==2 && type!=POSITION_TYPE_SELL)) continue;
      same++;
      double open=PositionGetDouble(POSITION_PRICE_OPEN);
      if(MathAbs(entryPrice-open)<minDist) return false;
   }
   if(same>=MaxSameDirectionTrades) return false;
   return true;
}

//+------------------------------------------------------------------+
//| v5.55: Open primary + immediate hedge for one multi-pair symbol  |
//+------------------------------------------------------------------+
bool OpenMultiPairCandlePair(int idx, int direction, double primaryLot)
{
   if(idx<0 || idx>=g_pairCount) return false;
   string symbol=g_pts[idx].symbol;
   MqlTick tick;
   if(!SymbolInfoTick(symbol,tick) || tick.ask<=0 || tick.bid<=0) return false;
   primaryLot=NormalizePairVolume(symbol,primaryLot);
   double hedgeLot=NormalizePairVolume(symbol,primaryLot*MathMax(CandleHedgeMultiplier,0.0));
   if(primaryLot<=0 || hedgeLot<=0) return false;

   if(direction==1)
   {
      if(!PairCandlePriceAllowed(idx,1,tick.ask)) return false;
      if(!PairCandlePriceAllowed(idx,2,tick.bid)) return false;
   }
   else
   {
      if(!PairCandlePriceAllowed(idx,2,tick.bid)) return false;
      if(!PairCandlePriceAllowed(idx,1,tick.ask)) return false;
   }

   datetime closedBar=iTime(symbol,g_currentTimeframe,1);
   string stamp=IntegerToString((int)closedBar);
   bool primaryOK=false, hedgeOK=false;
   if(direction==1)
   {
      primaryOK=g_pts[idx].trade.Buy(primaryLot,symbol,tick.ask,0,0,symbol+"-CANDLE-BUY-"+stamp);
      if(primaryOK) hedgeOK=g_pts[idx].trade.Sell(hedgeLot,symbol,tick.bid,0,0,symbol+"-CANDLE-HEDGE-SELL-"+stamp);
   }
   else
   {
      primaryOK=g_pts[idx].trade.Sell(primaryLot,symbol,tick.bid,0,0,symbol+"-CANDLE-SELL-"+stamp);
      if(primaryOK) hedgeOK=g_pts[idx].trade.Buy(hedgeLot,symbol,tick.ask,0,0,symbol+"-CANDLE-HEDGE-BUY-"+stamp);
   }
   if(!primaryOK)
   {
      g_lastServerFailTime=TimeCurrent();
      Print("MP CANDLE PRIMARY FAILED ",symbol," ret=",g_pts[idx].trade.ResultRetcode()," ",g_pts[idx].trade.ResultRetcodeDescription());
      return false;
   }
   if(!hedgeOK)
   {
      g_lastServerFailTime=TimeCurrent();
      Print("MP CANDLE HEDGE FAILED ",symbol," ret=",g_pts[idx].trade.ResultRetcode()," ",g_pts[idx].trade.ResultRetcodeDescription());
      // Roll back only the just-created candle pair legs.
      for(int i=PositionsTotal()-1;i>=0;i--)
      {
         ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
         string c=PositionGetString(POSITION_COMMENT);
         if(StringFind(c,stamp)>=0) g_pts[idx].trade.PositionClose(ticket);
      }
      return false;
   }

   if(primaryLot>g_pts[idx].candlePeakVolume) g_pts[idx].candlePeakVolume=primaryLot;
   if(hedgeLot>g_pts[idx].candlePeakVolume) g_pts[idx].candlePeakVolume=hedgeLot;
   g_pts[idx].candleReusePeak=false;
   g_pts[idx].candleNextVolume=g_pts[idx].candlePeakVolume;
   g_pts[idx].candleLastTradeTime=TimeCurrent();
   g_pts[idx].candleLastSignalBar=iTime(symbol,g_currentTimeframe,0);
   g_pts[idx].freshBarTime=g_pts[idx].candleLastSignalBar;
   g_pts[idx].candleUnlockStart=TimeCurrent();
   g_pts[idx].candleUnlockStage=0;
   g_pts[idx].candleLastUnlockTime=0;
   Print("MP CANDLE PAIR OPENED: ",symbol," ",direction==1?"BUY + SELL":"SELL + BUY",
         " primary=",DoubleToString(primaryLot,8)," hedge=",DoubleToString(hedgeLot,8),
         " peakVol=",DoubleToString(g_pts[idx].candlePeakVolume,8),
         " closedCandle=",TimeToString(closedBar));
   return true;
}

//+------------------------------------------------------------------+
//| v5.55: Closed-candle engine for every configured multi-pair      |
//+------------------------------------------------------------------+
void ManageMultiPairClosedCandleEntries()
{
   if(!Use_MultiPair || !Use_CandleClosedEntryMode || g_pairCount<=0) return;
   for(int p=0;p<g_pairCount;p++)
   {
      string symbol=g_pts[p].symbol;
      if(!SymbolInfoInteger(symbol,SYMBOL_SELECT)) continue;
      MqlTick tick; if(!SymbolInfoTick(symbol,tick) || tick.ask<=0 || tick.bid<=0) continue;
      if(!CheckPairDataReady(p)) continue;
      if(!CheckTimeFilter()) continue;
      datetime currentBar=iTime(symbol,g_currentTimeframe,0);
      if(currentBar<=0 || currentBar==g_pts[p].candleLastSignalBar) continue;

      double o=iOpen(symbol,g_currentTimeframe,1);
      double c=iClose(symbol,g_currentTimeframe,1);
      if(o<=0 || c<=0)
      { g_pts[p].candleLastSignalBar=currentBar; continue; }
      if(c==o)
      { g_pts[p].candleLastSignalBar=currentBar; continue; }

      AnalyzePairPositions(p);
      int pairs=MathMin(g_pts[p].buyCount,g_pts[p].sellCount);
      if(pairs>=CandleMaxPairs || g_pts[p].totalCount+2>MaxTrades)
      { g_pts[p].candleLastSignalBar=currentBar; continue; }
      if(MinTradeDelaySec>0 && g_pts[p].candleLastTradeTime>0 && TimeCurrent()-g_pts[p].candleLastTradeTime<MinTradeDelaySec)
         continue;

      double volume=Lot;
      if(CandleUsePeakVolume && g_pts[p].candleReusePeak && g_pts[p].candlePeakVolume>0)
         volume=g_pts[p].candlePeakVolume*MathMax(CandleCycleMultiplier,0.0);
      else if(CandleUsePeakVolume && g_pts[p].candlePeakVolume>0)
         volume=g_pts[p].candlePeakVolume;
      volume=NormalizePairVolume(symbol,volume);
      if(volume<=0) continue;

      int direction=(c>o?1:2);
      if(OpenMultiPairCandlePair(p,direction,volume))
         g_pts[p].candleLastSignalBar=currentBar;
   }
}

//+------------------------------------------------------------------+
//| v5.58.1: NET basket trail per multi-pair symbol                     |
//+------------------------------------------------------------------+
void ManageMultiPairCandleBasketNetTrail()
{
   if(!Use_MultiPair || !Use_CandleBasketTrail) return;
   for(int p=0;p<g_pairCount;p++)
   {
      string symbol=g_pts[p].symbol;
      MqlTick tick; if(!SymbolInfoTick(symbol,tick) || tick.ask<=0 || tick.bid<=0) continue;
      AnalyzePairPositions(p);
      if(g_pts[p].totalCount<=0)
      {
         g_pts[p].candleBasketPeakProfit=0.0;
         g_pts[p].candleBasketTrailActive=false;
         continue;
      }
      if(BasketTrailCooldownSec>0 && g_pts[p].lastCandleBasketClose>0 &&
         TimeCurrent()-g_pts[p].lastCandleBasketClose < BasketTrailCooldownSec) continue;

      double balance=AccountInfoDouble(ACCOUNT_BALANCE);
      double startMoney=MathMax(BasketTrailMinProfitMoney,
                                balance*MathMax(BasketTrailStartPct,0.0)/100.0);
      datetime cycleStart=g_pts[p].candleUnlockStart;
      if(cycleStart<=0)
      {
         // Establish a cycle anchor from the oldest current position.
         datetime oldest=0;
         for(int j=PositionsTotal()-1;j>=0;j--)
         {
            ulong tk=PositionGetTicket(j); if(tk==0) continue;
            if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
            if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
            datetime ot=(datetime)PositionGetInteger(POSITION_TIME);
            if(oldest==0 || ot<oldest) oldest=ot;
         }
         g_pts[p].candleUnlockStart=oldest;
         cycleStart=oldest;
      }
      double floatingNet=0.0, realizedNet=0.0;
      double net=GetCandleCycleTrueNet(symbol,cycleStart,floatingNet,realizedNet);
      if(net<=0) continue;

      if(net>g_pts[p].candleBasketPeakProfit)
      {
         g_pts[p].candleBasketPeakProfit=net;
         if(net>=startMoney) g_pts[p].candleBasketTrailActive=true;
         continue;
      }
      if(!g_pts[p].candleBasketTrailActive || g_pts[p].candleBasketPeakProfit<startMoney) continue;

      double retracePct=(g_pts[p].candleBasketPeakProfit-net)/g_pts[p].candleBasketPeakProfit*100.0;
      if(retracePct<MathMax(BasketTrailRetracePct,1.0) || net<BasketTrailMinProfitMoney) continue;

      double peakBefore=g_pts[p].candleBasketPeakProfit;
      double peakVol=g_pts[p].candlePeakVolume;
      for(int i=PositionsTotal()-1;i>=0;i--)
      {
         ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
         peakVol=MathMax(peakVol,PositionGetDouble(POSITION_VOLUME));
      }
      if(peakVol>0)
      {
         g_pts[p].candlePeakVolume=peakVol;
         g_pts[p].candleNextVolume=NormalizePairVolume(symbol,peakVol*MathMax(CandleCycleMultiplier,0.0));
         g_pts[p].candleReusePeak=true;
      }

      for(int i=PositionsTotal()-1;i>=0;i--)
      {
         ulong ticket=PositionGetTicket(i); if(ticket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
         bool closeIt=false;
         if(EquityATR_CloseMode==EQUITY_TRAIL_CLOSE_BASKET) closeIt=true;
         else if(EquityATR_CloseMode==EQUITY_TRAIL_CLOSE_PROFITABLE)
         {
            double profit=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
            closeIt=(profit>0);
         }
         else closeIt=(PositionGetInteger(POSITION_TYPE)==EquityATR_SelectedSide);

         if(closeIt && !g_pts[p].trade.PositionClose(ticket))
            Print("V5.60 MP BASKET CLOSE FAIL ",symbol," #",ticket,
                  " ret=",g_pts[p].trade.ResultRetcode()," ",g_pts[p].trade.ResultRetcodeDescription());
      }

      g_pts[p].lastCandleBasketClose=TimeCurrent();
      g_pts[p].candleBasketPeakProfit=0.0;
      g_pts[p].candleBasketTrailActive=false;
      Print("V5.60 MP NET TRAIL: ",symbol,
            " peak=",DoubleToString(peakBefore,2),
            " current=",DoubleToString(net,2),
            " retrace=",DoubleToString(retracePct,1),"%",
            " mode=",IntegerToString((int)EquityATR_CloseMode),
            " nextVol=",DoubleToString(g_pts[p].candleNextVolume,2));
   }
}

//+------------------------------------------------------------------+
//| Legacy per-position MP trail; disabled in candle mode             |
//+------------------------------------------------------------------+
void ManageMultiPairUnifiedTrailing()
{
   if(!Use_MultiPair || !Use_UnifiedTrailing) return;
   for(int p=0; p<g_pairCount; p++)
   {
      string symbol = g_pts[p].symbol;
      MqlTick tick;
      if(!SymbolInfoTick(symbol,tick) || tick.ask<=0 || tick.bid<=0) continue;

      double atr = GetPairATR(symbol,Trail_ATR_Timeframe,Trail_ATR_Period);
      if(atr<=0) continue;
      double R = atr*MathMax(UnifiedRiskATR,0.1);
      double trailDist = atr*MathMax(UnifiedTrailATR,0.5);
      double point = SymbolInfoDouble(symbol,SYMBOL_POINT);
      double stopLevel = SymbolInfoInteger(symbol,SYMBOL_TRADE_STOPS_LEVEL)*point;
      double minStep = MathMax(UnifiedMinStepPts,1.0)*point;
      int digits = (int)SymbolInfoInteger(symbol,SYMBOL_DIGITS);

      for(int i=PositionsTotal()-1;i>=0;i--)
      {
         ulong ticket=PositionGetTicket(i);
         if(ticket==0) continue;
         if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
         if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;

         long type=PositionGetInteger(POSITION_TYPE);
         if(type!=POSITION_TYPE_BUY && type!=POSITION_TYPE_SELL) continue;
         double open=PositionGetDouble(POSITION_PRICE_OPEN);
         double sl=PositionGetDouble(POSITION_SL);
         double tp=PositionGetDouble(POSITION_TP);
         double profitPrice=(type==POSITION_TYPE_BUY?tick.bid-open:open-tick.ask);
         double profitR=profitPrice/R;
         if(profitR<UnifiedStartR) continue;

         // Scalping mode: ATR trailing is active immediately at StartR.
         double desired=(type==POSITION_TYPE_BUY?tick.bid-trailDist:tick.ask+trailDist);

         if(profitR>=UnifiedBER)
         {
            double bePrice=(type==POSITION_TYPE_BUY?open+0.05*R:open-0.05*R);
            desired=(type==POSITION_TYPE_BUY?MathMax(desired,bePrice):MathMin(desired,bePrice));
         }
         if(profitR>=UnifiedLockR)
         {
            double lockPrice=(type==POSITION_TYPE_BUY?open+UnifiedLockedR*R:open-UnifiedLockedR*R);
            desired=(type==POSITION_TYPE_BUY?MathMax(desired,lockPrice):MathMin(desired,lockPrice));
         }

         if(type==POSITION_TYPE_BUY)
         {
            desired=MathMin(desired,tick.bid-stopLevel-2*point);
            desired=NormalizeDouble(desired,digits);
            if(desired>=tick.bid) continue;
            if(sl>0 && desired<=sl+minStep) continue;
         }
         else
         {
            desired=MathMax(desired,tick.ask+stopLevel+2*point);
            desired=NormalizeDouble(desired,digits);
            if(desired<=tick.ask) continue;
            if(sl>0 && desired>=sl-minStep) continue;
         }

         if(!g_pts[p].trade.PositionModify(ticket,desired,tp))
         {
            g_lastServerFailTime=TimeCurrent();
            Print("MP SCALP TRAIL FAIL ",symbol," #",ticket,
                  " ret=",g_pts[p].trade.ResultRetcode()," ",g_pts[p].trade.ResultRetcodeDescription(),
                  " desired=",DoubleToString(desired,digits));
         }
         else
         {
            Print("MP SCALP TRAIL ",symbol," #",ticket,
                  " SL=",DoubleToString(desired,digits)," R=",DoubleToString(profitR,2));
         }
      }
   }
}

void ManageMultiPair()
{
   if(!Use_MultiPair || g_pairCount == 0) return;

   // v5.60: Multi-pair uses the SAME closed-candle BUY/SELL + immediate hedge engine.
   if(Use_CandleClosedEntryMode)
   {
      ManageMultiPairClosedCandleEntries();
      return;
   }

   // Legacy multi-pair mode remains available when candle mode is disabled.
   for(int p=0; p<g_pairCount; p++)
      ManagePairTrading(p);
}

