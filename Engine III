         ChartSetInteger(0, CHART_SHOW_PERIOD_SEP, false);
         ChartSetInteger(0, CHART_MODE, CHART_CANDLES);
      }
      ChartRedraw(0);
   }

   Print("EA initialized on ", _Symbol, " | Point: ", _Point, " | Digits: ", _Digits, " | magic=", g_magic, " | v5.66-CLEAN-PRO-DASHBOARD");

   return(INIT_SUCCEEDED);
}

