   Print("V5.60 BASKET CLOSE: ",_Symbol,
         " mode=",IntegerToString((int)EquityATR_CloseMode),
         " peakVol=",DoubleToString(g_peakVolume,2),
         " nextVol=",DoubleToString(g_nextCandleVolume,2));
   return 1;
}

//+------------------------------------------------------------------+
//| v5.58.1: NET basket peak/retracement trail for chart symbol         |
//| No individual BUY/SELL SL modification is performed in candle mode. |
//+------------------------------------------------------------------+
int FindProfitPeak(const ulong ticket)
{
   for(int i=0;i<g_profitPeakCount;i++)
      if(g_profitPeaks[i].ticket==ticket) return i;
   return -1;
}

int EnsureProfitPeak(const ulong ticket,const datetime openTime,const double currentProfit)
{
   int idx=FindProfitPeak(ticket);
   if(idx>=0) return idx;
   if(g_profitPeakCount>=ArraySize(g_profitPeaks)) return -1;
   idx=g_profitPeakCount++;
   g_profitPeaks[idx].ticket=ticket;
   g_profitPeaks[idx].peakProfit=currentProfit;
   g_profitPeaks[idx].openTime=openTime;
   return idx;
}

void CleanupProfitPeaks()
{
   for(int i=g_profitPeakCount-1;i>=0;i--)
   {
      bool exists=false;
      for(int p=PositionsTotal()-1;p>=0;p--)
      {
         ulong ticket=PositionGetTicket(p);
         if(ticket==g_profitPeaks[i].ticket) { exists=true; break; }
      }
      if(!exists)
      {
         g_profitPeaks[i]=g_profitPeaks[g_profitPeakCount-1];
         g_profitPeakCount--;
      }
   }
}

bool ManageCandleIndividualProfitCaptureSymbol(const string symbol,CTrade &trader)
{
   if(!Use_CandleClosedEntryMode) return false;
   if(CandleProfitCaptureMode<=0) return false;
   bool changed=false;
   CleanupProfitPeaks();

   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=g_magic) continue;
      string comment=PositionGetString(POSITION_COMMENT);
      // Only protect directional/primary positions. Hedge legs remain managed by unlock.
      if(StringFind(comment,"HEDGE")>=0) continue;

      double profit=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      if(profit<CandleProfitCaptureStartMoney) continue;
      datetime openTime=(datetime)PositionGetInteger(POSITION_TIME);
      if(CandleProfitCaptureMinHoldSec>0 && TimeCurrent()-openTime<CandleProfitCaptureMinHoldSec) continue;

      int idx=EnsureProfitPeak(ticket,openTime,profit);
      if(idx<0) continue;
      if(profit>g_profitPeaks[idx].peakProfit)
         g_profitPeaks[idx].peakProfit=profit;

      double peak=g_profitPeaks[idx].peakProfit;
      if(peak<CandleProfitCaptureStartMoney || peak<=0.0) continue;
      double retrace=(peak-profit)/peak*100.0;
      if(retrace<CandleProfitCaptureRetracePct) continue;
      if(profit<CandleProfitCaptureMinLockMoney) continue;

      // Full individual close is only allowed once the cycle itself is net positive.
      if(CandleProfitCaptureMode==1 && CandleProfitCaptureFullCloseRequireNet)
      {
         double fn=0.0,rn=0.0;
         datetime cycleStart=(g_candleUnlockStart>0?g_candleUnlockStart:openTime);
         double trueNet=GetCandleCycleTrueNet(symbol,cycleStart,fn,rn);
         if(trueNet<CandleUnlockMinNetProfit) continue;
      }

      bool ok=false;
      double vol=PositionGetDouble(POSITION_VOLUME);
      double minLot=SymbolInfoDouble(symbol,SYMBOL_VOLUME_MIN);
      double step=SymbolInfoDouble(symbol,SYMBOL_VOLUME_STEP);
      if(step<=0.0) step=minLot;
      if(CandleProfitCaptureMode==1)
      {
         ok=trader.PositionClose(ticket);
      }
      else
      {
         double closeVol=vol*MathMax(0.0,MathMin(100.0,CandleProfitCapturePartialPct))/100.0;
         closeVol=MathFloor(closeVol/step)*step;
         closeVol=NormalizeDouble(closeVol,8);
         if(closeVol>=minLot && closeVol<vol-step/2.0)
            ok=trader.PositionClosePartial(ticket,closeVol);
         else if(closeVol>=vol-step/2.0)
            ok=trader.PositionClose(ticket);
      }

      if(ok)
      {
         changed=true;
         Print("V5.68 PROFIT CAPTURE ",symbol," #",ticket,
               " mode=",IntegerToString(CandleProfitCaptureMode),
               " peak=$",DoubleToString(peak,2),
               " current=$",DoubleToString(profit,2),
               " retrace=",DoubleToString(retrace,1),"%");
         g_profitPeaks[idx].peakProfit=0.0;
      }
   }
   return changed;
}

void ManageCandleIndividualProfitCapture()
{
   ManageCandleIndividualProfitCaptureSymbol(_Symbol,trade);
}

void ManageMultiPairCandleIndividualProfitCapture()
{
   if(!Use_MultiPair || g_pairCount<=0) return;
   for(int p=0;p<g_pairCount;p++)
      ManageCandleIndividualProfitCaptureSymbol(g_pts[p].symbol,g_pts[p].trade);
}

void ManageCandleBasketNetTrail()
{
   if(!Use_CandleBasketTrail || g_totalCount<=0) return;
   if(BasketTrailCooldownSec>0 && g_lastCandleBasketClose>0 &&
      TimeCurrent()-g_lastCandleBasketClose < BasketTrailCooldownSec) return;

   double balance=AccountInfoDouble(ACCOUNT_BALANCE);
   double startMoney=MathMax(BasketTrailMinProfitMoney,
                             balance*MathMax(BasketTrailStartPct,0.0)/100.0);
   double floatingNet=0.0, realizedNet=0.0;
   datetime cycleStart=(g_candleUnlockStart>0 ? g_candleUnlockStart : iTime(_Symbol,g_currentTimeframe,1));
   double net=GetCandleCycleTrueNet(_Symbol,cycleStart,floatingNet,realizedNet);
   if(net<=0) return;

   if(net>g_candleBasketPeakProfit)
   {
      g_candleBasketPeakProfit=net;
      if(net>=startMoney) g_candleBasketTrailActive=true;
      return;
   }
   if(!g_candleBasketTrailActive || g_candleBasketPeakProfit<startMoney) return;

   double retracePct=(g_candleBasketPeakProfit-net)/g_candleBasketPeakProfit*100.0;
   if(retracePct>=MathMax(BasketTrailRetracePct,1.0) && net>=BasketTrailMinProfitMoney)
   {
      double peakBefore=g_candleBasketPeakProfit;
      CloseChartSymbolBasketByMode();
      Print("V5.60 NET TRAIL: ",_Symbol,
            " peak=",DoubleToString(peakBefore,2),
            " current=",DoubleToString(net,2),
            " retrace=",DoubleToString(retracePct,1),"%",
            " mode=",IntegerToString((int)EquityATR_CloseMode));
      g_candleBasketPeakProfit=0.0;
      g_candleBasketTrailActive=false;
   }
}

//+------------------------------------------------------------------+
//| Unified position trailing — legacy mode only                      |
//+------------------------------------------------------------------+
void ManageUnifiedTrailing()
{
   if(!Use_UnifiedTrailing || g_totalCount <= 0) return;
   double atr = GetATRValue();
   if(atr <= 0) return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0 || ask <= 0) return;

   double R = atr * MathMax(UnifiedRiskATR, 0.1);
   double trailDist = atr * MathMax(UnifiedTrailATR, 0.5);
   double stopLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   double minStep = MathMax(UnifiedMinStepPts, 1.0) * _Point;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_magic) continue;

      long type = PositionGetInteger(POSITION_TYPE);
      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl = PositionGetDouble(POSITION_SL);
      double tp = PositionGetDouble(POSITION_TP);
      if(type != POSITION_TYPE_BUY && type != POSITION_TYPE_SELL) continue;

      double profitPrice = (type == POSITION_TYPE_BUY ? bid - open : open - ask);
      double profitR = profitPrice / R;
      if(profitR < UnifiedStartR) continue;

      // Scalping mode: ATR trailing is active immediately once the start threshold is reached.
      // BE/lock are floors; they can only tighten the ATR trail, never loosen it.
      double desired = (type == POSITION_TYPE_BUY ? bid - trailDist : ask + trailDist);

      if(profitR >= UnifiedBER)
      {
         double bePrice = (type == POSITION_TYPE_BUY ? open + 0.05 * R : open - 0.05 * R);
         if(type == POSITION_TYPE_BUY) desired = MathMax(desired, bePrice);
         else desired = MathMin(desired, bePrice);
      }

      if(profitR >= UnifiedLockR)
      {
         double lockPrice = (type == POSITION_TYPE_BUY ? open + UnifiedLockedR * R : open - UnifiedLockedR * R);
         if(type == POSITION_TYPE_BUY) desired = MathMax(desired, lockPrice);
         else desired = MathMin(desired, lockPrice);
      }

      if(type == POSITION_TYPE_BUY)
      {
         desired = MathMin(desired, bid - stopLevel - 2*_Point);
         desired = NormalizeDouble(desired, _Digits);
         if(desired >= bid) continue;
         if(sl > 0 && desired <= sl + minStep) continue;
         if(trade.PositionModify(ticket, desired, tp))
            Print("SCALP TRAIL BUY #", ticket, " SL=", DoubleToString(desired,_Digits), " R=", DoubleToString(profitR,2));
         else
            Print("SCALP TRAIL BUY FAIL #", ticket, " ret=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription(),
                  " desired=", DoubleToString(desired,_Digits), " bid=", DoubleToString(bid,_Digits));
      }
      else
      {
         desired = MathMax(desired, ask + stopLevel + 2*_Point);
         desired = NormalizeDouble(desired, _Digits);
         if(desired <= ask) continue;
         if(sl > 0 && desired >= sl - minStep) continue;
         if(trade.PositionModify(ticket, desired, tp))
            Print("SCALP TRAIL SELL #", ticket, " SL=", DoubleToString(desired,_Digits), " R=", DoubleToString(profitR,2));
         else
            Print("SCALP TRAIL SELL FAIL #", ticket, " ret=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription(),
                  " desired=", DoubleToString(desired,_Digits), " ask=", DoubleToString(ask,_Digits));
      }
   }
}

