         score+=25.0;
   }

   if(UnlockUseEMA)
   {
      int hf=iMA(_Symbol,g_currentTimeframe,UnlockEMAFast,0,MODE_EMA,PRICE_CLOSE);
      int hs=iMA(_Symbol,g_currentTimeframe,UnlockEMASlow,0,MODE_EMA,PRICE_CLOSE);
      double bf[],bs[];
      ArraySetAsSeries(bf,true); ArraySetAsSeries(bs,true);
      if(hf!=INVALID_HANDLE && hs!=INVALID_HANDLE &&
         CopyBuffer(hf,0,1,1,bf)==1 && CopyBuffer(hs,0,1,1,bs)==1)
      {
         if((bull && bf[0]>bs[0]) || (bear && bf[0]<bs[0])) score+=20.0;
      }
      if(hf!=INVALID_HANDLE) IndicatorRelease(hf);
      if(hs!=INVALID_HANDLE) IndicatorRelease(hs);
   }

   if(UnlockUseADX)
   {
      int h=iADX(_Symbol,g_currentTimeframe,UnlockADXPeriod);
      double b[]; ArraySetAsSeries(b,true);
      if(h!=INVALID_HANDLE && CopyBuffer(h,0,1,1,b)==1)
      {
         if(b[0]>=UnlockADXNeutral) score+=15.0;
         if(b[0]>=UnlockADXTrend) score+=10.0;
      }
      if(h!=INVALID_HANDLE) IndicatorRelease(h);
   }

   if(UnlockUseATR)
   {
      double atr=GetATRValue();
      double body=MathAbs(rates[1].close-rates[1].open);
      if(atr>0.0 && body>=atr*UnlockATRBodyFactor) score+=20.0;
   }

   if(g_totalProfit>0.0) score+=10.0;
