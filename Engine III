bool DashboardMagicAllowed(const long magic)
{
   if(magic==(long)g_magic) return true;
   if(DashboardIncludeSecondaryMagic && magic==(long)DashboardSecondaryMagic) return true;
   return false;
}

void CalculateMultiPairStats()
{
   if(!Use_MultiPair || g_pairCount == 0) return;

   for(int p = 0; p < g_pairCount; p++)
   {
      string sym = g_pairList[p];
      g_pairProfit[p] = 0;
      g_pairBuyCount[p] = 0;
      g_pairSellCount[p] = 0;
      g_pairLots[p] = 0;
      g_pairBuyLots[p] = 0;
      g_pairSellLots[p] = 0;

      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetString(POSITION_SYMBOL) != sym) continue;
         if(!DashboardMagicAllowed(PositionGetInteger(POSITION_MAGIC))) continue;

         double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
         double lot = PositionGetDouble(POSITION_VOLUME);
         ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

         g_pairProfit[p] += profit;
         g_pairLots[p] += lot;

         if(type == POSITION_TYPE_BUY)
         {
            g_pairBuyCount[p]++;
            g_pairBuyLots[p] += lot;
         }
         else
         {
            g_pairSellCount[p]++;
            g_pairSellLots[p] += lot;
         }
      }

      double pairEq = g_pairProfit[p];
      if(pairEq > g_pairPeak[p])
         g_pairPeak[p] = pairEq;

      if(g_pairPeak[p] > 0)
      {
         double dd = g_pairPeak[p] - pairEq;
         if(dd > g_pairMaxDD[p])
            g_pairMaxDD[p] = dd;
      }
   }
}

